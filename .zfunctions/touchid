#!/usr/bin/env zsh

function touchid() {
  local isDebug=false
  [[ "$1" == "--debug" ]] && isDebug=true

  source $HOME/.config/_functions.zsh

  if can_sudo; then
    echo -e "\n${MAGENTA}Configuring TouchID for sudo...${RESET}\n"
    if touch_sudo; then
      _skip "Enable TouchID sudo (Enabled)"
      return 0
    fi

    if ! bioutil -r -s 2>/dev/null | grep -Eq '(Touch ID|Biometrics) functionality:[[:space:]]*1'; then
      $isDebug && _cross "Enable TouchID sudo (No Sensor)"
      return 1
    fi

    if ! bioutil -c 2>/dev/null | grep -Eq '[1-9][0-9]* (fingerprint|biometric template)'; then
      _cross "Enable TouchID sudo (No Fingerprint)"
      open "x-apple.systempreferences:com.apple.Touch-ID-Settings.extension"
      return 1
    fi
    
    echo -e "-- ${YELLOW} Requesting sudo to enable TouchID for sudo${RESET} --\n"
    if sed -e 's/^#auth/auth/' /etc/pam.d/sudo_local.template | sudo tee /etc/pam.d/sudo_local > /dev/null; then
       _check "Enable TouchID sudo"
    else
       _cross "Enable TouchID sudo"
       return 1
    fi
  else
    $isDebug && _cross "Enable TouchID sudo (No Rights)"
  fi

  echo ""
  return 0
}

touchid "$@"