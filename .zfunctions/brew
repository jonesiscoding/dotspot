#!/usr/bin/env zsh

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if ((!${+commands[brew]})); then
  # @brief Auto-installer for Homebrew if not found in PATH
  function brew() {
    echo "Homebrew not found. Starting installation..."

    # Run the official Homebrew installation script
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || return $?

    # Re-evaluate paths immediately after installation completes
    if [[ -x /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi

    # Allow subsequent 'brew' calls execute natively
    unfunction brew

    # Call the newly installed binary
    if ((${+commands[brew]})); then
      command brew "$@"
    else
      return 1
    fi
  }
fi
