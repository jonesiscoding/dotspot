#!/usr/bin/env zsh

function composer() {
  local xComposer
  
  if [[ -x /opt/homebrew/bin/composer ]]; then
    xComposer="/opt/homebrew/bin/composer"
  elif [[ -x /usr/local/bin/composer ]]; then
    xComposer="/usr/local/bin/composer"
  else
    # Run the official Composer installation via Homebrew
    brew install composer || return $?

    # Re-evaluate paths immediately after installation completes
    if [[ -x /opt/homebrew/bin/composer ]]; then
      xComposer="/opt/homebrew/bin/composer"
    elif [[ -x /usr/local/bin/brew ]]; then
      xComposer="/usr/local/bin/brew"      
    fi
  fi

  $xComposer "$@" || return $?

  if [[ -d "$(pwd)/vendor" ]]; then
    if ! tmutil isexcluded "$(pwd)/vendor" | grep -Fq '[Excluded]'; then
      tmutil addexclusion "$(pwd)/vendor" || return 0
    fi
  fi

  return 0
}
