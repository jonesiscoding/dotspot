#!/usr/bin/env zsh

function composer() {
  local xCMP=$(/usr/bin/which composer)
  if [ -z "$xCMP" ]; then
    echo "The composer executable is not installed!"
    exit 1
  fi

  if $xCMP "$@"; then
    if uname | grep "Darwin"; then
      # Rename to avoid iCloud Sync
      if [ -d vendor ] && [ ! -L vendor ]; then
        mv vendor vendor.nosync
        ln -s vendor.nosync vendor
      fi
      # Exclude from Time Machine
      if ! tmutil isexcluded "${path}" | grep -Fq '[Excluded]'; then
        tmutil addexclusion "$(pwd)/vendor.nosync"
      fi
      # Hide from View
      chflags hidden vendor.nosync
    fi
  fi
}