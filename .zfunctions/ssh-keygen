#!/usr/bin/zsh

if [[ -z "${HR:-}" ]]; then
  # shellcheck source=./_functions.zsh
  source $HOME/.config/_functions.zsh
fi

function ssh-keygen() {
  local ghAlgo ghEmail keyGithub configDir configFile

  install -d "$HOME/.ssh/config.d" -m 644

  if printf "%s\n" "$@" | /usr/bin/grep -q "\-\-default"; then
    echo -e "\n${MAGENTA}Configuring Default SSH Key...${RESET}\n"

    if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
      if /usr/bin/ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519"; then
        eval "$(ssh-agent -s)"
        echo ""
        _check "Create SSH Key (id_ed25519)"
      else
        _cross "Create SSH Key (id_ed25519)"
        return 1
      fi
    else 
      _skip "Create SSH Key (id_ed25519)"
    fi

    return 0
  fi

  if printf "%s\n" "$@" | /usr/bin/grep -q "\-\-github"; then
    echo -e "\n${MAGENTA}Configuring GitHub SSH Key...${RESET}\n"
    while [ "$1" != "" ]; do
      # Check flags
      case "$1" in
        -t )  ghAlgo="$2";    shift;   ;;
        -C )  ghEmail="$2";   shift;   ;;
        -f )  keyGithub="$2"; shift;   ;;
      esac
      shift # move to next kv pair
    done
    [ -z "$ghAlgo" ] && ghAlgo="$GH_ALGORITHM"
    [ -z "$ghAlgo" ] && ghAlgo="ed25519"
    [ -z "$ghEmail" ] && ghEmail="$GH_EMAIL"
    [ -z "$ghEmail" ] && ghEmail="$USER@$(hostname -f | awk -F '.' '{ printf("%s.%s", $(NF - 1), $NF) }')"
    [ -z "$keyGithub" ] && keyGithub="$HOME/.ssh/id_${ghAlgo}_github"

    if /usr/bin/ssh-keygen -t "$ghAlgo" -N '' -C "$ghEmail" -f "$keyGithub"; then
      eval "$(ssh-agent -s)"
      echo ""
      _check "Create SSH Key (id_${ghAlgo}_github)"
    else
      _cross "Create SSH Key (id_${ghAlgo}_github)"
      return 1
    fi

    # Create config.github
    configDir="$HOME/.ssh/config.d"
    configFile="$configDir/config.github"
    [ ! -d "$configDir" ] && mkdir -p "$configDir" && chmod 744 "$configDir"
    if [ ! -f "$configFile" ] || [ -z "$(cat "$configFile")" ]; then
      cat >> "$configFile" <<EOF
Host github.com
  HostName github.com
  IdentityFile ${keyGithub}
EOF
    fi
    return 0
  fi

  /usr/bin/ssh-keygen "$@"
}

ssh-keygen "$@"