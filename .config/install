#!/usr/bin/env zsh

repo="jonesiscoding/dotspot"
repoUrl="https://github.com/${repo}.git"

function dot {
   /usr/bin/git --git-dir=$HOME/.dot/ --work-tree=$HOME $@
}

cd "$HOME" || exit 1
if [ -d "$HOME/.dot" ]; then
  echo "Run the following command to reinstall: "
  echo "rm -Rf \"\$HOME/.dot\" && $SHELL -c \"\$(curl -fsSL https://raw.githubusercontent.com/${repo}/HEAD/.config/install)\""
  if [ -f "/usr/bin/pbcopy" ]; then
    echo "rm -Rf \"\$HOME/.dot\" && $SHELL -c \"\$(curl -fsSL https://raw.githubusercontent.com/${repo}/HEAD/.config/install)\"" | pbcopy
  fi
  exit 1
fi

git clone --bare $repoUrl $HOME/.dot
dot checkout
if [ $? = 0 ]; then
  echo "Checked out ${repo}.";
else
  mkdir -p .dot-backup
  echo "Moving pre-existing dot files to $HOME/.dot-backup";
  dot checkout 2>&1 | egrep "\s+\." | awk {'print $1'} | tar czf ".dot-backup/dot-$(date +%Y%m%d-%H%M%S).tar.gz" --null -T -
fi;

dot config status.showUntrackedFiles no
dot config pull.rebase true
dot config rebase.autoStash true
