#!/usr/bin/env zsh

repo="jonesiscoding/dotspot"
repoUrl="https://github.com/${repo}.git"

function dot {
   /usr/bin/git --git-dir=$HOME/.dot/ --work-tree=$HOME $@
}

cd "$HOME" || exit 1
if [ -d "$HOME/.dot" ]; then
  reinstall_cmd="rm -Rf \"\$HOME/.dot\" && curl -fsSL https://raw.githubusercontent.com/${repo}/HEAD/.config/install | zsh"
  echo "Run the following command to reinstall:"
  echo "$reinstall_cmd"
  if [ -x "/usr/bin/pbcopy" ]; then
    print -rn -- "$reinstall_cmd" | pbcopy
  fi
  exit 1
fi

git clone --bare $repoUrl $HOME/.dot
dot checkout
if [ $? = 0 ]; then
  echo "Checked out ${repo}.";
else
  backup_dir="$HOME/.dot-backup/$(date +%Y%m%d-%H%M%S)"
  echo "Moving pre-existing dot files to $backup_dir"

  dot checkout 2>&1 | grep -E "^\s+" | awk '{print $1}' | while IFS= read -r file; do
    mkdir -p "$backup_dir/${file:h}"
    mv "$HOME/$file" "$backup_dir/$file"
  done
fi;

dot config status.showUntrackedFiles no
dot config pull.rebase true
dot config rebase.autoStash true
