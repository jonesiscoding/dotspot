#!/usr/bin/env zsh

# @brief Bootstrap script for ZSH dotfiles on macOS
# @option --skip-defaults Skip macOS preferences
# @option --skip-ssh Skip SSH
# @option --skip-env Skip Environment Config

set -euo pipefail

# shellcheck source=./_functions.zsh
source "$HOME/.config/_functions.zsh"

# Input Handling
isOs=true
isSsh=true
isEnv=true
isDebug=false
isTouchSudo=true
isSkipTouchSudo=false
hostname=""
while [ "${1:-}" != "" ]; do
  # Check flags
  case "$1" in
    --skip-touchid )       isTouchSudo=false;            ;;
    --skip-defaults )      isOs=false;                   ;;
    --skip-ssh )           isSsh=false;                  ;;
    --skip-env )           isEnv=false;                  ;;
    --debug )              isDebug=true;                 ;;
    --hostname )           hostname="$2"; shift;         ;;
  esac
  shift # move to next kv pair
done

fpath=($HOME/.zfunctions $fpath)
! can_touchid && isTouchSudo=false
if $isTouchSudo; then
  autoload -Uz touchid
  if $isDebug; then
    touchid --debug || exit $?
  else
    touchid || exit $?
  fi
fi

if [[ -n "$hostname" ]]; then
  autoload -Uz set-hostname
  set-hostname "$hostname" || exit $?
fi

if $isEnv; then
  # shellcheck source=./env.zsh
  source "$HOME/.config/env.zsh"
  configure_env || exit $?
fi

if $isSsh; then
  autoload -Uz ssh-keygen
  ssh-keygen --default || exit $?
fi

if $isOs; then
  # shellcheck source=./macos.zsh
  source "$HOME/.config/macos.zsh"
  configure_macos || exit $?
fi

echo -e "\nBootstrap complete. Please restart your terminal or run 'source ~/.zprofile'.\n"