#!/usr/bin/env zsh

# @brief Bootstrap script for ZSH dotfiles on macOS
# @option --prefs Configure macOS preferences
# @option --ssh Configure SSH
# @option --env Configure environment variables

set -euo pipefail

# shellcheck source=./_functions.zsh
source "$HOME/.config/_functions.zsh"

# Input Handling
isOs=false
isSsh=false
isEnv=false
isDebug=false
isTouchSudo=false
isSkipTouchSudo=false
hostname=""
while [ "${1:-}" != "" ]; do
  # Check flags
  case "$1" in
    --no-touch-sudo )      isSkipTouchSudo=true;         ;;
    --touchid )            isTouchSudo=true;             ;;
    --prefs )              isOs=true;                    ;;
    --ssh )                isSsh=true;                   ;;
    --env )                isEnv=true;                   ;;
    --debug )              isDebug=true;                 ;;
    --hostname )           hostname="$2"; shift;         ;;
  esac
  shift # move to next kv pair
done

($isEnv || $isOs || [[ -n "$hostname" ]]) && $isTouchSudo=true
$isSkipTouchSudo && isTouchSudo=false
if $isTouchSudo; then
  # shellcheck source=./touchid.sh
  source "$HOME/.config/touchid.sh"
  configure_touch_sudo || exit $?
fi

if [[ -n "$hostname" ]]; then
   # shellcheck source=./host.zsh
  source "$HOME/.config/host.zsh"
  configure_host "$hostname" || exit $?
fi

if $isEnv; then
  # shellcheck source=./env.zsh
  source "$HOME/.config/env.zsh"
  configure_env || exit $?
fi

if $isSsh; then
  # shellcheck source=./ssh.zsh
  source "$HOME/.config/ssh.zsh"
  configure_ssh || exit $?
fi

if $isOs; then
  # shellcheck source=./macos.zsh
  source "$HOME/.config/macos.zsh"
  configure_macos || exit $?
fi

echo -e "\nBootstrap complete. Please restart your terminal or run 'source ~/.zprofile'.\n"