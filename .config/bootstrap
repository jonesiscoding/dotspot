#!/usr/bin/env zsh

# @brief Bootstrap script for ZSH dotfiles on macOS
# @option --prefs Configure macOS preferences
# @option --ssh Configure SSH
# @option --env Configure environment variables

set -euo pipefail

# shellcheck source=./_functions.zsh
source "$HOME/.config/_functions.zsh"

# Input Handling
isOs=false
isSsh=false
isEnv=false
while [ "$1" != "" ]; do
  # Check flags
  case "$1" in
    --prefs )              isOs=true;                    ;;
    --ssh )                isSsh=true;                   ;;
    --env )                isEnv=true;                   ;;
    --hostname )           hostname="$2"; shift;         ;;
  esac
  shift # move to next kv pair
done

if [[ -n "$hostname" ]]; then
  scutil --set HostName "$hostname"
fi

if $isEnv; then
  # shellcheck source=./functions/env.sh
  source "$HOME/.config/functions/env.zsh"
  configure_env || exit $?
fi

if $isSsh; then
  # shellcheck source=./ssh.zsh
  source "$HOME/.config/ssh.zsh"
  configure_ssh || exit $?
fi

if $isOs; then
  # shellcheck source=./macos.zsh
  source "$HOME/.config/functions/macos.zsh"
  configure_macos || exit $?
fi

echo "Bootstrap complete. Please restart your terminal or run 'source ~/.zprofile'."